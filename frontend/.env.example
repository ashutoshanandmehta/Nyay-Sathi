# Existing browser development keeps its FastAPI proxy.
VITE_BACKEND=legacy

# Android/Supabase migration builds use VITE_BACKEND=supabase.
# These are PUBLIC client settings, included in the APK. Never put a service-role,
# secret, database password, Google client secret or OpenAI key in VITE_* values.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
