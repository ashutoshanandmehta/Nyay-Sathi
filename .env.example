OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_REVIEW_MODEL=gpt-6.1-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-realtime-2.1-mini
OPENAI_WEB_SEARCH_MODEL=gpt-6-astra
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
LIVE_EVAL_MAX_CASES=0
LIVE_EVAL_MAX_MODEL_CALLS=0
LIVE_EVAL_MAX_COST_USD=0
ASSISTANT_ENGINE=primary_agent
VECTOR_INDEX_ENABLED=false
AGENT_MAX_REQUESTS=6
AGENT_MAX_ROUNDS=3
AGENT_DEADLINE_SECONDS=180
AGENT_RESEARCH_SECONDS=20
AGENT_MAX_BATCHES=2
AGENT_MAX_QUERIES=3
AGENT_MAX_DOCUMENTS=6
AGENT_MAX_PASSAGES=5
AGENT_MAX_TOKENS=160000
AGENT_MAX_OUTPUT_TOKENS=6000
# Optional strict projected-spend cap requires dated AGENT_PRICING JSON for every model.
# AGENT_MAX_COST_USD=
# AGENT_PRICING_DATE=
# AGENT_PRICING={}
MAX_MODEL_CALLS_PER_TURN=8
WEB_RESEARCH_ENABLED=true
WEB_MAX_QUERIES=2
WEB_MAX_DOCUMENTS=3
WEB_RESEARCH_TIMEOUT_SECONDS=40
WEB_MAX_DOWNLOAD_BYTES=5242880
WEB_MAX_PDF_PAGES=60
WEB_CACHE_TTL_SECONDS=3600
REQUESTS_PER_MINUTE=120
